# cp .env.docker.example .env; use `openssl rand -hex 32` to generate a token.
# Token mode (default): FLOWLET_ADMIN_TOKEN is required.
# OIDC mode: set FLOWLET_ADMIN_AUTH_MODE=oidc and the FLOWLET_OIDC_* values below;
# FLOWLET_ADMIN_TOKEN then only matters for optional break-glass login.
FLOWLET_ADMIN_AUTH_MODE=token
FLOWLET_ADMIN_TOKEN=
# Optional; left empty, a random client token is generated and persisted on first start.
FLOWLET_CLIENT_TOKEN=
FLOWLET_WEB_PORT=20134
FLOWLET_PROXY_PORT=20135
# Base URL without /v1, as reachable by your clients. Set this when using port mappings.
FLOWLET_PUBLIC_PROXY_URL=http://localhost:20135
RUST_LOG=info

# Optional build mirror for Debian packages in mainland China:
# DEBIAN_MIRROR=http://mirrors.tuna.tsinghua.edu.cn

# --- Optional: management SSO via a standard OIDC provider (GitLab) ---
# FLOWLET_ADMIN_AUTH_MODE=oidc
# FLOWLET_PUBLIC_WEB_URL=http://10.100.217.60:20134
# FLOWLET_OIDC_ISSUER=http://git.17usoft.com
# FLOWLET_OIDC_DISCOVERY_URL=https://git.17usoft.com/.well-known/openid-configuration
# FLOWLET_OIDC_ALLOW_HTTP_ISSUER=1
# FLOWLET_OIDC_CLIENT_ID=<GitLab Application ID>
# FLOWLET_OIDC_CLIENT_SECRET=<GitLab Secret>
# FLOWLET_OIDC_SCOPES=openid
# FLOWLET_OIDC_DISPLAY_NAME=GitLab
# FLOWLET_OIDC_ALLOWED_SUBS=<your GitLab sub>
# FLOWLET_OIDC_PKCE=auto
# FLOWLET_OIDC_NONCE=required
# FLOWLET_ADMIN_SESSION_IDLE_MINUTES=30
# FLOWLET_ADMIN_SESSION_TTL_HOURS=8
