{
  "name": "flowlet",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "website",
    "packages/*"
  ],
  "scripts": {
    "version:set": "node scripts/set-version.mjs",
    "dev": "vite",
    "dev:frontend": "vite --mode demo",
    "dev:mobile": "vite --mode mobile",
    "build": "tsc && vite build",
    "build:mobile": "tsc && vite build --mode mobile --outDir dist-mobile",
    "fetch:catalogs": "node scripts/fetch-models-cn.mjs && node scripts/fetch-models-dev.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/fetch-models-cn.mjs && node scripts/fetch-models-dev.mjs && tauri build && node scripts/build-portable.mjs",
    "tauri:build:portable": "node scripts/fetch-models-cn.mjs && node scripts/fetch-models-dev.mjs && tauri build --no-bundle && node scripts/build-portable.mjs",
    "tauri:update:portable": "node scripts/update-portable.mjs --layout tauri --replace-config",
    "tauri:android:init": "node scripts/tauri-android.mjs init",
    "tauri:android:dev": "node scripts/tauri-android.mjs dev",
    "tauri:android:build": "node scripts/tauri-android.mjs build --apk --target aarch64",
    "tauri:android:build:aab": "node scripts/tauri-android.mjs build --aab --target aarch64",
    "tauri:android:install": "node scripts/tauri-android.mjs install",
    "check": "tsc --noEmit",
    "test": "vitest run --config src/vitest.config.ts",
    "test:watch": "vitest --config src/vitest.config.ts",
    "website:dev": "npm run dev --workspace flowlet-website",
    "website:check": "npm run check --workspace flowlet-website",
    "website:build": "npm run build --workspace flowlet-website",
    "build:web": "tsc && vite build --mode web --outDir dist-web && node scripts/build-local-access.mjs",
    "dev:web": "vite --mode web",
    "build:desktop": "tsc && vite build --mode desktop --outDir dist-desktop",
    "dev:desktop": "vite --mode desktop",
    "node:host": "node packages/flowlet-core/src/index.ts",
    "node:typecheck": "tsc -p packages/flowlet-core/tsconfig.json",
    "node:parity": "node scripts/web-parity.mjs",
    "node:e2e": "node scripts/e2e-node-host.mjs",
    "flowlet": "node packages/flowlet-cred/src/cli.ts",
    "cred": "node packages/flowlet-cred/src/cli.ts",
    "cred:test": "node --test packages/flowlet-cred/src/__tests__/",
    "cred:compat": "node packages/flowlet-cred/scripts/compat.mjs",
    "cred:typecheck": "tsc -p packages/flowlet-cred/tsconfig.json",
    "desktop:dev": "node scripts/build-desktop.mjs --dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:dist": "node scripts/build-desktop.mjs --dist",
    "desktop:typecheck": "tsc -p packages/flowlet-desktop/tsconfig.json",
    "desktop:smoke": "node scripts/smoke-desktop.mjs",
    "desktop:smoke:pages": "node scripts/smoke-desktop-pages.mjs",
    "desktop:smoke:client": "node scripts/smoke-desktop-client.mjs",
    "desktop:portable": "node scripts/build-desktop-portable.mjs",
    "desktop:update:portable": "node scripts/update-portable.mjs --layout electron"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "^2.101.0",
    "@douyinfe/semi-ui-19": "^2.102.0",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.5",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "katex": "^0.18.4",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-util-sanitize-uri": "^2.0.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
