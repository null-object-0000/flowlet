{
  "name": "flowlet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite --mode demo",
    "dev:mobile": "vite --mode mobile",
    "build": "tsc && vite build",
    "build:mobile": "tsc && vite build --mode mobile --outDir dist-mobile",
    "fetch:catalogs": "node scripts/fetch-models-cn.mjs && node scripts/fetch-models-dev.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/fetch-models-cn.mjs && node scripts/fetch-models-dev.mjs && tauri build && node scripts/build-portable.mjs",
    "tauri:build:portable": "node scripts/fetch-models-cn.mjs && node scripts/fetch-models-dev.mjs && tauri build --no-bundle && node scripts/build-portable.mjs",
    "tauri:update:portable": "node scripts/update-portable.mjs --replace-config",
    "tauri:android:init": "node scripts/tauri-android.mjs init",
    "tauri:android:dev": "node scripts/tauri-android.mjs dev",
    "tauri:android:build": "node scripts/tauri-android.mjs build --apk --target aarch64",
    "tauri:android:build:aab": "node scripts/tauri-android.mjs build --aab --target aarch64",
    "tauri:android:install": "node scripts/tauri-android.mjs install",
    "check": "tsc --noEmit",
    "test": "vitest run --config src/vitest.config.ts",
    "test:watch": "vitest --config src/vitest.config.ts",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "^2.101.0",
    "@douyinfe/semi-ui-19": "^2.102.0",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.5",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
