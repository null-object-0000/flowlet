{
  "name": "flowlet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --mode mobile",
    "build": "tsc && vite build",
    "build:mobile": "tsc && vite build --mode mobile",
    "preview": "vite preview",
    "fetch:models-cn": "node scripts/fetch-models-cn.mjs",
    "fetch:models-dev": "node scripts/fetch-models-dev.mjs",
    "fetch:catalogs": "node scripts/fetch-models-cn.mjs && node scripts/fetch-models-dev.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/fetch-models-cn.mjs && node scripts/fetch-models-dev.mjs && tauri build && node scripts/build-portable.mjs",
    "tauri:build:portable": "node scripts/fetch-models-cn.mjs && node scripts/fetch-models-dev.mjs && tauri build --no-bundle && node scripts/build-portable.mjs",
    "tauri:portable": "node scripts/build-portable.mjs",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build --apk --target aarch64",
    "tauri:android:build:aab": "tauri android build --aab --target aarch64",
    "check": "tsc --noEmit",
    "test": "vitest run --config src/vitest.config.ts",
    "test:watch": "vitest --config src/vitest.config.ts"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "^2.101.0",
    "@douyinfe/semi-ui-19": "^2.101.1",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
