{
  "schemaVersion": 4,
  "plugins": [
    { "id": "flowlet.models.builtin", "kind": "model-catalog", "source": "model-catalog.json" },
    { "id": "flowlet.channel.longcat", "kind": "channel", "channelId": "longcat", "adapterId": "longcat" },
    { "id": "flowlet.channel.deepseek", "kind": "channel", "channelId": "deepseek", "adapterId": "deepseek" },
    { "id": "flowlet.channel.kimi", "kind": "channel", "channelId": "kimi", "adapterId": "kimi" },
    { "id": "flowlet.channel.qwen", "kind": "channel", "channelId": "qwen", "adapterId": "qwen" },
    { "id": "flowlet.channel.custom", "kind": "channel", "channelId": "custom", "adapterId": "custom" },
    { "id": "flowlet.channel.zhipu", "kind": "channel", "channelId": "zhipu", "adapterId": "zhipu" },
    { "id": "flowlet.channel.openrouter", "kind": "channel", "channelId": "openrouter", "adapterId": "openrouter" },
    {
      "id": "flowlet.agent.claude-code",
      "kind": "agent",
      "agent": {
        "id": "claude-code",
        "name": "Claude Code",
        "environmentAdapterId": "claude-code",
        "globalConfigAdapterId": "claude-code",
        "sessionAdapterId": "claude-code",
        "identityAdapterId": "claude-code",
        "runnerAdapterId": "claude-code",
        "sessionTypes": [{ "id": "claude-code", "name": "Claude Code", "clientId": "claude-code" }],
        "taskProfile": { "name": "Claude Code", "sessionType": "claude-code" },
        "configCapabilities": [
          { "id": "primary-long-context", "name": "主模型 1M 长上下文", "kind": "boolean", "defaultEnabled": false, "requiresRestart": true },
          { "id": "fast-long-context", "name": "快速模型 1M 长上下文", "kind": "boolean", "defaultEnabled": false, "requiresRestart": true }
        ],
        "endpointSuffix": "/anthropic",
        "npmPackage": "@anthropic-ai/claude-code",
        "surfaces": ["cli"],
        "iconSrc": "/icons/lobe/claudecode.svg",
        "tone": "claude",
        "officialUrl": "https://code.claude.com/docs/en/setup",
        "updateUrl": "https://code.claude.com/docs/en/whats-new",
        "showsCredentialsFile": false,
        "showsFastModel": true,
        "showsSubagentModel": true,
        "supportsManagedConfig": true,
        "environmentDescription": "识别 Claude Code 的安装位置、版本和安装方式",
        "notInstalledText": "未检测到 Claude Code。Flowlet 会检查 PATH 和官方常见安装位置。",
        "globalConfigDescription": "配置后可从任意终端或 IDE 启动 Claude Code",
        "manualDescription": "以下内容与一键写入的 Claude Code 全局配置一致",
        "restartTip": "修改全局配置后请重新启动 Claude Code。"
      }
    },
    {
      "id": "flowlet.agent.opencode",
      "kind": "agent",
      "agent": {
        "id": "opencode",
        "name": "OpenCode",
        "environmentAdapterId": "opencode",
        "globalConfigAdapterId": "opencode",
        "sessionAdapterId": "opencode",
        "identityAdapterId": "opencode",
        "runnerAdapterId": "opencode",
        "sessionTypes": [{ "id": "opencode", "name": "OpenCode", "clientId": "opencode" }],
        "taskProfile": { "name": "OpenCode", "sessionType": "opencode" },
        "configCapabilities": [
          { "id": "model-specs", "name": "输入模态声明", "kind": "boolean", "defaultEnabled": false, "requiresRestart": true }
        ],
        "endpointSuffix": "/v1",
        "npmPackage": "opencode-ai",
        "surfaces": ["cli", "desktop"],
        "iconSrc": "/icons/lobe/opencode.svg",
        "officialUrl": "https://opencode.ai/docs",
        "updateUrl": "https://github.com/anomalyco/opencode/releases",
        "showsCredentialsFile": true,
        "showsFastModel": true,
        "showsSubagentModel": false,
        "supportsManagedConfig": true,
        "environmentDescription": "识别 OpenCode CLI 与 Desktop 的安装位置和版本",
        "notInstalledText": "未检测到 OpenCode CLI 或 Desktop。Flowlet 会检查 PATH 和常见安装位置。",
        "globalConfigDescription": "OpenCode CLI 与 Desktop 共用此全局配置",
        "manualDescription": "OpenCode 的 Provider 配置与凭据文件需要分别设置",
        "restartTip": "修改全局配置后请重新启动 OpenCode CLI 与 Desktop。"
      }
    },
    {
      "id": "flowlet.agent.pi",
      "kind": "agent",
      "agent": {
        "id": "pi",
        "name": "Pi",
        "environmentAdapterId": "pi",
        "globalConfigAdapterId": "pi",
        "sessionAdapterId": "pi",
        "identityAdapterId": "pi",
        "runnerAdapterId": "pi",
        "sessionTypes": [{ "id": "pi", "name": "Pi", "clientId": "pi" }],
        "taskProfile": { "name": "Pi", "sessionType": "pi" },
        "configCapabilities": [
          { "id": "session-extension", "name": "精确会话关联", "kind": "boolean", "defaultEnabled": false, "requiresRestart": true },
          { "id": "model-specs", "name": "输入模态声明", "kind": "boolean", "defaultEnabled": false, "requiresRestart": false }
        ],
        "endpointSuffix": "/v1",
        "npmPackage": "@earendil-works/pi-coding-agent",
        "surfaces": ["cli"],
        "iconSrc": "/icons/lobe/pi.svg",
        "officialUrl": "https://pi.dev",
        "updateUrl": "https://github.com/earendil-works/pi/blob/main/packages/coding-agent/CHANGELOG.md",
        "showsCredentialsFile": true,
        "showsFastModel": false,
        "showsSubagentModel": false,
        "supportsManagedConfig": true,
        "environmentDescription": "识别 Pi CLI 的安装位置和版本",
        "notInstalledText": "未检测到 Pi。Flowlet 会检查 PATH 和常见安装位置。",
        "globalConfigDescription": "Pi 的 Provider 定义在 models.json，凭据在 auth.json，默认模型在 settings.json",
        "manualDescription": "Pi 的 models.json、auth.json 与 settings.json 需要分别设置",
        "restartTip": "修改全局配置后请重新启动 Pi。"
      }
    },
    {
      "id": "flowlet.agent.codex",
      "kind": "agent",
      "agent": {
        "id": "codex",
        "name": "Codex",
        "environmentAdapterId": "chatgpt-desktop",
        "globalConfigAdapterId": "codex",
        "sessionAdapterId": "codex",
        "identityAdapterId": "codex",
        "runnerAdapterId": "codex",
        "sessionTypes": [
          { "id": "codex-desktop", "name": "Codex Desktop", "clientId": "codex-desktop" },
          { "id": "codex-cli", "name": "Codex CLI", "clientId": "codex" }
        ],
        "taskProfile": { "name": "Codex", "sessionType": "codex-cli" },
        "configCapabilities": [],
        "endpointSuffix": "/v1",
        "npmPackage": "@openai/codex",
        "surfaces": ["cli", "desktop"],
        "iconSrc": "/icons/lobe/openai.svg",
        "officialUrl": "https://learn.chatgpt.com/docs/codex/cli",
        "updateUrl": "https://learn.chatgpt.com/docs/changelog?type=codex-cli",
        "showsCredentialsFile": true,
        "showsFastModel": false,
        "showsSubagentModel": false,
        "supportsManagedConfig": true,
        "environmentDescription": "识别 Codex CLI 与 ChatGPT Desktop 的安装位置和版本",
        "notInstalledText": "未检测到 Codex CLI 或 ChatGPT Desktop。Flowlet 会检查 PATH 与常见安装位置。",
        "globalConfigDescription": "Codex CLI、ChatGPT 桌面端与 VS Code 插件共用此全局配置",
        "manualDescription": "以下内容与一键写入的 Codex 全局配置一致",
        "restartTip": "修改全局配置后请重新启动 Codex CLI 与 ChatGPT Desktop。"
      }
    },
    {
      "id": "flowlet.agent.deepseek-harness",
      "kind": "agent",
      "agent": {
        "id": "deepseek-harness",
        "name": "DeepSeek Harness",
        "environmentAdapterId": "deepseek-harness",
        "globalConfigAdapterId": "deepseek-harness",
        "sessionAdapterId": "deepseek-harness",
        "identityAdapterId": "deepseek-harness",
        "runnerAdapterId": "deepseek-harness",
        "sessionTypes": [{ "id": "deepseek-harness", "name": "DeepSeek Harness", "clientId": "deepseek-harness" }],
        "taskProfile": { "name": "DeepSeek Harness", "sessionType": "deepseek-harness" },
        "configCapabilities": [
          { "id": "session-extension", "name": "精确会话关联", "kind": "boolean", "defaultEnabled": false, "requiresRestart": true },
          { "id": "model-specs", "name": "模型规格声明", "kind": "boolean", "defaultEnabled": false, "requiresRestart": false },
          { "id": "mcp-servers", "name": "MCP 服务器", "kind": "list", "defaultEnabled": false, "requiresRestart": false }
        ],
        "endpointSuffix": "/v1",
        "npmPackage": "@deepseek-ai/dsh",
        "surfaces": ["web"],
        "iconSrc": "/icons/lobe/deepseek-color.svg",
        "officialUrl": "https://www.deepseek.com/harness/",
        "updateUrl": "https://www.npmjs.com/package/@deepseek-ai/dsh",
        "showsCredentialsFile": true,
        "showsFastModel": false,
        "showsSubagentModel": false,
        "supportsManagedConfig": true,
        "environmentDescription": "识别 DeepSeek Harness 的本地 Web、Harness 目录与可用启动入口",
        "notInstalledText": "未检测到 DeepSeek Harness。Flowlet 会检查本地 Harness 目录、运行中的 Web 服务和 PATH 中的 dsh。",
        "globalConfigDescription": "Flowlet 直接写入 Provider、默认模型与 Client Token",
        "manualDescription": "Flowlet 会安全合并 DSH 官方 YAML 配置；下方片段与一键写入内容一致。",
        "restartTip": "DSH 会热加载 settings.yaml 与 .credentials.yaml；配置生效无需重启 DSH Web。"
      }
    },
    {
      "id": "flowlet.agent.hermes",
      "kind": "agent",
      "agent": {
        "id": "hermes",
        "name": "Hermes Agent",
        "environmentAdapterId": "hermes",
        "globalConfigAdapterId": "hermes",
        "sessionAdapterId": "hermes",
        "identityAdapterId": "hermes",
        "runnerAdapterId": "hermes",
        "sessionTypes": [{ "id": "hermes", "name": "Hermes Agent", "clientId": "hermes" }],
        "taskProfile": { "name": "Hermes Agent", "sessionType": "hermes" },
        "configCapabilities": [],
        "endpointSuffix": "/v1",
        "npmPackage": "hermes-agent",
        "surfaces": ["cli"],
        "iconSrc": "/icons/lobe/hermesagent.svg",
        "officialUrl": "https://hermes-agent.nousresearch.com/",
        "updateUrl": "https://github.com/NousResearch/hermes-agent/releases",
        "showsCredentialsFile": true,
        "showsFastModel": false,
        "showsSubagentModel": false,
        "supportsManagedConfig": true,
        "environmentDescription": "识别 Hermes Agent CLI 的安装位置和版本",
        "notInstalledText": "未检测到 Hermes Agent。Flowlet 会检查 PATH 和官方常见安装位置。",
        "globalConfigDescription": "Hermes Agent 使用 ~/.hermes/config.yaml 描述模型与 Provider，API Key 以 ${HERMES_CUSTOM_…_API_KEY} 引用写入 ~/.hermes/.env",
        "manualDescription": "以下内容与一键写入的 Hermes Agent config.yaml 与 .env 配置一致",
        "restartTip": "config.yaml 在下次 hermes chat 启动时读取；修改后请重新启动 Hermes Agent。"
      }
    }
  ]
}
