# Copy this file to keystore.properties and replace every placeholder.
# keystore.properties and *.jks are ignored by Git.
storePassword=<release keystore password>
keyPassword=<release key password>
keyAlias=flowlet
# Use an absolute path. Escape Windows backslashes, for example:
# C:\\Users\\your-name\\flowlet-release.jks
storeFile=<absolute path to flowlet-release.jks>
