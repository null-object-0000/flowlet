{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowlet",
  "version": "../package.json",
  "identifier": "site.snewbie.flowlet",
  "build": {
    "beforeDevCommand": "npm run dev:mobile",
    "beforeBuildCommand": "npm run build:mobile",
    "frontendDist": "../dist-mobile"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": true,
        "title": "Flowlet",
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "../resources/icons/icon.png"
    ],
    "resources": {
      "../config.json": "config.json",
      "../resources/catalogs/models-cn.json": "models-cn.json",
      "../resources/catalogs/models-dev.json": "models-dev.json"
    }
  }
}
